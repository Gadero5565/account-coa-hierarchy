<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Optional hierarchy view for the standard Chart of Accounts.

        Account Type nodes are virtual frontend nodes.
        Account cards are real account.account records.
    -->
    <record id="view_account_account_coa_hierarchy" model="ir.ui.view">
        <field name="name">account.account.coa.hierarchy</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <hierarchy parent_field="coa_hierarchy_parent_id"
                js_class="account_coa_hierarchy_native"
                draggable="0"
                create="0"
                edit="0"
                delete="0">
                <field name="name"/>
                <field name="code"/>
                <field name="account_type"/>
                <field name="coa_hierarchy_parent_id"/>
                <field name="coa_hierarchy_is_type_node"/>
                <field name="coa_hierarchy_account_count"/>

                <templates>
                    <t t-name="hierarchy-box">

                        <!-- Virtual Account Type node -->
                        <t t-if="record.coa_hierarchy_is_type_node.raw_value">
                            <div class="o_coa_hierarchy_type_card">
                                <div class="o_coa_hierarchy_type_header">
                                    <i class="fa fa-folder-open-o"
                                        role="img"
                                        aria-label="Account Type"
                                        title="Account Type"/>
                                    <span class="o_coa_hierarchy_type_title">
                                        <field name="account_type"/>
                                    </span>
                                </div>

                                <div class="o_coa_hierarchy_type_count text-muted">
                                    <strong t-out="record.coa_hierarchy_account_count.raw_value"/>
                                    <t t-if="record.coa_hierarchy_account_count.raw_value === 1">
                                        <span class="ms-1">Account</span>
                                    </t>
                                    <t t-else="">
                                        <span class="ms-1">Accounts</span>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Real account.account node -->
                        <t t-else="">
                            <div class="o_coa_hierarchy_account_card">
                                <div class="o_coa_hierarchy_account_code_row">
                                    <span class="o_coa_hierarchy_account_code"
                                        t-att-title="record.code.raw_value">
                                        <field name="code"/>
                                    </span>
                                </div>

                                <div class="o_coa_hierarchy_account_name"
                                    t-att-title="record.name.raw_value">
                                    <field name="name"/>
                                </div>
                                <div class="o_coa_hierarchy_account_type text-muted">
                                    <field name="account_type"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <!--
        Preserve Odoo 17's standard Chart of Accounts view order.
        Tree remains the default view and Hierarchy is appended last.
    -->
    <record id="account.action_account_form" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,hierarchy</field>
    </record>

</odoo>