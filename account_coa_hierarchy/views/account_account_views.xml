<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_coa_hierarchy_native" model="ir.ui.view">
        <field name="name">account.account.hierarchy.by.type</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <hierarchy parent_field="coa_hierarchy_parent_id"
                       js_class="account_coa_hierarchy_native"
                       icon="fa-sitemap"
                       draggable="0"
                       create="0"
                       edit="0"
                       delete="0"
                       default_order="code, placeholder_code">
                <field name="name"/>
                <field name="code"/>
                <field name="placeholder_code" invisible="1"/>
                <field name="account_type"/>
                <field name="currency_id"/>
                <field name="reconcile"/>
                <field name="coa_hierarchy_parent_id" invisible="1"/>
                <field name="coa_hierarchy_is_type_node" invisible="1"/>
                <field name="coa_hierarchy_account_count" invisible="1"/>

                <templates>
                    <t t-name="hierarchy-box">
                        <t t-if="record.coa_hierarchy_is_type_node.raw_value">
                            <div class="o_coa_hierarchy_type_card">
                                <div class="o_coa_hierarchy_type_header">
                                    <i class="fa fa-folder-open-o"
                                       role="img"
                                       aria-label="Account Type"
                                       title="Account Type"/>
                                    <span class="o_coa_hierarchy_type_title">
                                        <field name="account_type"/>
                                    </span>
                                </div>
                                <div class="o_coa_hierarchy_type_count text-muted">
                                    <strong t-out="record.coa_hierarchy_account_count.raw_value"/>
                                    <t t-if="record.coa_hierarchy_account_count.raw_value === 1">
                                        <span class="ms-1">Account</span>
                                    </t>
                                    <t t-else="">
                                        <span class="ms-1">Accounts</span>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="o_coa_hierarchy_account_card">
                                <div class="o_coa_hierarchy_account_code_row">
                                    <span class="o_coa_hierarchy_account_code"
                                          t-att-title="record.placeholder_code.raw_value || record.code.raw_value">
                                        <field name="code"
                                               widget="char_with_placeholder_field"
                                               options="{'placeholder_field': 'placeholder_code'}"/>
                                    </span>
                                </div>
                                <div class="o_coa_hierarchy_account_name"
                                     t-att-title="record.name.raw_value">
                                    <field name="name"/>
                                </div>
                                <div class="o_coa_hierarchy_account_type text-muted">
                                    <field name="account_type"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <!--
        Keep Odoo's standard Chart of Accounts ordering unchanged and append
        Hierarchy as the last optional view:
            list -> kanban -> form -> hierarchy

        Do NOT bind the hierarchy through ir.actions.act_window.view here.
        Explicit act_window.view rows are evaluated before the modes that only
        come from view_mode, which would make Hierarchy the default view.
    -->
    <record id="account.action_account_form" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,hierarchy</field>
    </record>

</odoo>
